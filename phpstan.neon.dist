includes:
	- vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
	level: 5
	paths:
		- plugins
	bootstrapFiles:
		- bin/phpstan-bootstrap.php
		- bin/phpstan-woocommerce-stubs.php
	scanFiles:
		- /var/www/wordpress/wp-includes/ai-client.php
		- /var/www/wordpress/wp-includes/ai-client/class-wp-ai-client-prompt-builder.php
	scanDirectories:
		- /var/www/wordpress/wp-includes/php-ai-client/src
		- /var/www/wordpress/wp-content/plugins/ai-provider-for-openai/src
	excludePaths:
		analyseAndScan:
			- plugins/*/tests/*
			- plugins/*/vendor/*
			- plugins/*/node_modules/*
